---
// Voda Tour & Event — PackageCard Component
// Individual package card with photo area, icon badge, price

import type { PackageWithDestination } from "../types/directus";
import { getAssetUrl } from "../lib/directus";
import { getStartingPrice, stripHtml } from "../lib/utils";

interface Props {
  /** Alternate: pass full package object */
  package?: PackageWithDestination;
  /** Show destination name */
  showDestination?: boolean;
  title?: string;
  description?: string;
  slug?: string;
  /** Price tier pertama sebagai harga mulai */
  priceFrom?: number;
  image?: string;
  icon?: string;
  category?: string;
  lcp?: boolean;
}

const {
  title: _title,
  description: _desc,
  slug: _slug,
  priceFrom: _priceFrom,
  image: _img,
  icon = "fa-solid fa-map-marked-alt",
  category = 'wisata',
  showDestination,
  lcp = false,
  package: pkg,
} = Astro.props;

// Support both individual props AND full package object
const title = _title || pkg?.name || '';
const description = _desc || pkg?.description || '';
const cleanDescription = typeof description === 'string' ? stripHtml(description) : '';
const slug = _slug || pkg?.slug || '';
const priceFrom = _priceFrom ?? (pkg ? getStartingPrice(pkg.price_tiers || []) : undefined);
const image = _img || (pkg?.image ? getAssetUrl(pkg.image) + '?width=400&height=400&fit=cover&format=webp' : (pkg?.poster ? getAssetUrl(pkg.poster) + '?width=400&height=400&fit=cover&format=webp' : undefined));
const destName = pkg?.destination_id
  ? (typeof pkg.destination_id === 'object' ? pkg.destination_id?.name : '')
  : '';

const displayPrice = priceFrom
  ? new Intl.NumberFormat('id-ID').format(priceFrom)
  : null;
---

<a
  href={`/paket/${slug}`}
  class="group relative block w-full bg-white border border-slate-300 flex flex-col rounded-[var(--radius-md)] shadow-md overflow-hidden no-underline transition-all duration-300 hover:-translate-y-1.5 hover:shadow-xl hover:border-orange-400"
>
  <!-- Image Section -->
  <div class="relative w-full aspect-square bg-navy-900 overflow-hidden shrink-0">
    {image ? (
      <img
        src={image}
        alt={title}
        width="400"
        height="400"
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 group-hover:rotate-1"
        loading={lcp ? "eager" : "lazy"}
        fetchpriority={lcp ? "high" : "auto"}
      />
    ) : (
      <div class="w-full h-full flex flex-col items-center justify-center text-white/20">
        <i class="fa-regular fa-image text-5xl"></i>
        <span class="text-xs mt-2 font-medium">No Image</span>
      </div>
    )}
    <!-- Icon badge pinned top-left -->
    <div class="absolute top-4 left-4 z-10 w-10 h-10 bg-white rounded-full flex items-center justify-center text-navy-800 text-base shadow-[0_4px_12px_rgba(0,0,0,0.15)]">
      <i class={icon}></i>
    </div>
  </div>

  <!-- Body Content Section -->
  <div class="p-5 flex-1 flex flex-col">
    <h3 class="font-[family-name:var(--font-display)] text-navy-900 font-semibold text-[17px] leading-tight line-clamp-2">{title}</h3>
    <p class="text-navy-500 text-[13px] leading-relaxed mt-2 line-clamp-2 flex-1">{cleanDescription}</p>
    {showDestination && destName && <p class="text-xs text-navy-400 mt-2 font-medium"><i class="fa-solid fa-location-dot text-orange-500 text-[10px] mr-1.5"></i>{destName}</p>}

    <!-- Dashed divider -->
    <div class="border-t border-dashed border-navy-200 my-4"></div>

    <!-- Price row -->
    <div class="flex items-center justify-between mt-auto">
      <div>
        {displayPrice ? (
          <>
            <span class="text-xs text-navy-400 font-medium block leading-none mb-1">Mulai dari</span>
            <span class="font-[family-name:var(--font-display)] text-orange-500 font-bold text-[17px] leading-tight">Rp {displayPrice}</span>
          </>
        ) : (
          <span class="text-xs text-navy-400 italic">Hubungi kami</span>
        )}
      </div>
      <div class="w-10 h-10 bg-navy-50 rounded-full flex items-center justify-center text-navy-600 text-sm transition-all duration-200 group-hover:bg-orange-500 group-hover:text-white group-hover:scale-110">
        <i class="fa-solid fa-arrow-right"></i>
      </div>
    </div>
  </div>
</a>
